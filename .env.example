# Copy this file to .env on the server and replace SECRET_KEY.
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
JOB_DIR=/opt/projects/audio-converter/instance/jobs
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_FILE_SIZE=209715200
MAX_TOTAL_SIZE=524288000
MAX_FILES=10
JOB_TTL_SECONDS=1800
CONVERSION_TIMEOUT_SECONDS=900
MAX_WORKERS=2
